# Скопируй этот файл в .env и впиши значения. .env никуда не публикуется.

# TMDB: постеры, описания, где смотреть. themoviedb.org → Настройки → API → «Токен доступа к API (v4)»
TMDB_TOKEN=

# OMDb: оценки IMDb и Rotten Tomatoes. omdbapi.com/apikey.aspx → тариф FREE, ключ придёт на почту
OMDB_KEY=

# Кинопоиск (необязательно): оценки Кинопоиска. Телеграм-бот @kinopoiskdev_bot → бесплатный токен
KINOPOISK_KEY=

# Telegram: чтение канала. my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Заполнится само после запуска scripts/telegram_login.py
TELEGRAM_SESSION=

# Gemini: разбор новых постов и ИИ-подбор. aistudio.google.com/apikey (нужен VPN один раз)
GEMINI_KEY=

# Supabase: вход и общие отметки. supabase.com → проект → Project Settings → API Keys
SUPABASE_URL=
# публичный ключ (anon / publishable) — попадёт в код сайта, это нормально
SUPABASE_ANON_KEY=
# секретный ключ (service_role / secret) — только сюда и в секреты GitHub
SUPABASE_SERVICE_KEY=

# GitHub: репозиторий и токен для кнопки «Обновить» на сайте
GITHUB_REPO=Lisht1/recommendations
GITHUB_DISPATCH_TOKEN=

# Supabase: токен доступа для загрузки ИИ-функции. supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
